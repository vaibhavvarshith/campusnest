# ==========================================
# CampusNest - Environment Variables Example
# ==========================================

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campusnest_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# Backend Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
JWT_SECRET=campusnest_super_secret_jwt_signing_key_2026_at_least_256_bits_long!
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (Vite / React)
VITE_API_URL=http://localhost:8080/api
