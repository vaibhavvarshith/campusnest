# ==============================================================================
# CampusNest — Smart Library & Academic Management System
# Production & Local Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8080
TZ=Asia/Kolkata

# MySQL Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/campusnest_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=root

# Cloud / Railway Compatible Aliases (automatically mapped if set)
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
# SPRING_DATASOURCE_USERNAME=${MYSQLUSER}
# SPRING_DATASOURCE_PASSWORD=${MYSQLPASSWORD}

# Application Security (HMAC-SHA256/512 Key, at least 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Storage (Persistent volume path)
UPLOAD_DIR=uploads/submissions

# Frontend API URL (leave empty in production to automatically use relative /api on same host)
VITE_API_URL=/api
